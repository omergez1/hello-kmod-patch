diff -urN --no-dereference a/drivers/misc/hello_kmod.c b/drivers/misc/hello_kmod.c
--- a/drivers/misc/hello_kmod.c	1970-01-01 02:00:00.000000000 +0200
+++ b/drivers/misc/hello_kmod.c	2026-11-16 14:15:32.516946270 +0200
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * hello_kmod - a trivial kernel module.
+ * Prints "hello world" when loaded and "bye bye world" when unloaded.
+ */
+#include <linux/module.h>
+
+static int __init hello_kmod_init(void)
+{
+	pr_info("hello_kmod: hello world\n");
+	return 0;
+}
+
+static void __exit hello_kmod_exit(void)
+{
+	pr_info("hello_kmod: bye bye world\n");
+}
+
+module_init(hello_kmod_init);
+module_exit(hello_kmod_exit);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Trivial hello world kernel module");
+MODULE_AUTHOR("Omer Gez");
diff -urN --no-dereference a/drivers/misc/Kconfig b/drivers/misc/Kconfig
--- a/drivers/misc/Kconfig	2026-11-16 14:15:32.505946123 +0200
+++ b/drivers/misc/Kconfig	2026-11-16 14:15:41.836071481 +0200
@@ -654,4 +654,15 @@
 source "drivers/misc/pvpanic/Kconfig"
 source "drivers/misc/mchp_pci1xxxx/Kconfig"
 source "drivers/misc/keba/Kconfig"
+
+config HELLO_KMOD
+	tristate "Hello world kernel module"
+	default n
+	help
+	  A trivial example module. Prints "hello world" when loaded
+	  and "bye bye world" when unloaded.
+
+	  To compile this as a module, choose M here: the module
+	  will be called hello_kmod.
+
 endmenu
diff -urN --no-dereference a/drivers/misc/Makefile b/drivers/misc/Makefile
--- a/drivers/misc/Makefile	2026-11-16 14:15:32.507946149 +0200
+++ b/drivers/misc/Makefile	2026-11-16 14:15:32.516946270 +0200
@@ -75,3 +75,4 @@
 obj-$(CONFIG_NSM)		+= nsm.o
 obj-$(CONFIG_MARVELL_CN10K_DPI)	+= mrvl_cn10k_dpi.o
 obj-y				+= keba/
+obj-$(CONFIG_HELLO_KMOD)	+= hello_kmod.o
